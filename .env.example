SECRET_KEY=replace-with-a-long-random-secret
# Default SQL Server instance:
SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=EcommerceDB;Trusted_Connection=yes;Encrypt=no;TrustServerCertificate=yes;
# For SQL Server Express, change SERVER to localhost\SQLEXPRESS
MONGODB_URI=mongodb://localhost:27017/
# Replace these demonstration helpdesk values with verified production contacts.
SUPPORT_PHONE=0800-94562
SUPPORT_EMAIL=support@zilocart.pk
SUPPORT_HOURS=Monday-Saturday, 9:00 AM-8:00 PM PKT
RETURN_WINDOW_DAYS=14
FLASK_DEBUG=0
